{
  "name": "cordova-angular-chottulink-sample",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "cordova:prepare": "ng build --configuration development && shx rm -rf www && shx cp -r dist/cordova-angular-chottulink-sample/browser www",
    "cordova:android": "npm run cordova:prepare && cordova run android",
    "cordova:ios": "npm run cordova:prepare && cordova run ios",
    "cordova:build:android": "npm run cordova:prepare && cordova build android",
    "cordova:build:ios": "npm run cordova:prepare && cordova build ios"
  },
  "prettier": {
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^20.1.0",
    "@angular/compiler": "^20.1.0",
    "@angular/core": "^20.1.0",
    "@angular/forms": "^20.1.0",
    "@angular/platform-browser": "^20.1.0",
    "@angular/router": "^20.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^20.1.5",
    "@angular/cli": "^20.1.5",
    "@angular/compiler-cli": "^20.1.0",
    "@types/jasmine": "~5.1.0",
    "cordova-android": "^15.1.0",
    "cordova-ios": "^8.1.1",
    "cordova-plugin-chottulink-sdk": "^1.0.0",
    "jasmine-core": "~5.8.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "shx": "^0.3.4",
    "typescript": "~5.8.2"
  },
  "cordova": {
    "plugins": {
      "cordova-plugin-chottulink-sdk": {
        "CHOTTULINK_DOMAIN": "YOUR_CHOTTULINK_DOMAIN"
      }
    },
    "platforms": [
      "android",
      "ios"
    ]
  }
}
